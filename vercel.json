{
  "headers": [
    {
      "source": "/christmas/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/christmas/(data|app).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/christmas",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/christmas/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/christmas/index.html",
      "destination": "/",
      "permanent": false
    }
  ]
}
